{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/editorial/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Source Serif 4|IBM Plex Sans Condensed))/i]",
        "message": "Font not provided by the design system. Available: Source Serif 4, IBM Plex Sans Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArticleHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|sub|sectionHref|title|dek|author|role|authorHref|avatar|date|readTime|onShare|key|ref|className|style|children)$/]",
        "message": "<ArticleHeader> doesn't accept that prop. Declared props: section, sub, sectionHref, title, dek, author, role, authorHref, avatar, date, readTime, onShare."
      },
      {
        "selector": "JSXOpeningElement[name.name='AuthorBioLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<AuthorBioLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|outline|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, outline."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|disabled|full|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, disabled, full, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|interactive|raised|accentTop|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, padding, interactive, raised, accentTop."
      },
      {
        "selector": "JSXOpeningElement[name.name='EditorialBlogCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|sub|title|dek|date|readTime|author|image|href|featured|key|ref|className|style|children)$/]",
        "message": "<EditorialBlogCard> doesn't accept that prop. Declared props: section, sub, title, dek, date, readTime, author, image, href, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='PullQuote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|cite|key|ref|className|style|children)$/]",
        "message": "<PullQuote> doesn't accept that prop. Declared props: children, cite."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rubric'] > JSXAttribute > JSXIdentifier[name!=/^(?:section|sub|href|as|plain|key|ref|className|style|children)$/]",
        "message": "<Rubric> doesn't accept that prop. Declared props: section, sub, href, as, plain."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rubric'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|div)$/]",
        "message": "<Rubric> as must be one of 'p' | 'div'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShareButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|key|ref|className|style|children)$/]",
        "message": "<ShareButton> doesn't accept that prop. Declared props: label."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
